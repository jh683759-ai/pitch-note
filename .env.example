# Supabase 대시보드 > Project Settings > API 에서 복사해서 .env.local 에 넣으세요.
# (.env.local 은 git에 올라가지 않습니다. service_role 키는 절대 넣지 마세요.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# 배포 주소 (공유 링크·카톡 미리보기에 쓰임). 로컬에서는 비워두면 지금 주소를 씁니다.
# NEXT_PUBLIC_SITE_URL=https://pitch-note.example.com
